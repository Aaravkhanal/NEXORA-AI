# ─── LLM ──────────────────────────────────────────────────────────────────────
# At least ONE of these is required
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=                          # optional fallback

# ─── Data Sources ─────────────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_token_here      # recommended (avoid rate limits)
NEWS_API_KEY=your_newsapi_key_here       # from newsapi.org (free: 100 req/day)
ALPHA_VANTAGE_KEY=your_alphavantage_key  # from alphavantage.co (free: 25 req/day)
TAVILY_API_KEY=your_tavily_key_here      # from tavily.com (free: 1000 req/month)

# ─── App Settings ─────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
REQUEST_TIMEOUT=30
MAX_CRAWL_PAGES=20
CORS_ORIGINS=http://localhost:3000

# ─── Vector DB ────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=models/text-embedding-004
